# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Tracker (Jira) ---
# Site host, no scheme (e.g. your Atlassian cloud host)
JIRA_SITE=
# Account email used for Basic auth on the REST API
JIRA_EMAIL=
# Project key. Issue keys are then PROJ-123.
JIRA_PROJECT=PROJ
# API token from id.atlassian.com/manage-profile/security/api-tokens
# Prefer setting this in your shell (setx / export) over writing it in .env.
JIRA_TOKEN=

# --- Wiki (Confluence) ---
# Space key searched for feature documentation
CONFLUENCE_SPACE=

# --- Repositories for the recon step ---
# owner/name — used to find the change commit by issue key
REPO_BACKEND=
REPO_FRONTEND=
# Automation repo (Playwright). Local path is preferred: no network, no token.
REPO_AUTOMATION=
AUTOMATION_REPO_PATH=

# --- Local paths ---
# Curated QA knowledge base read by qa-context and written at the end of a run.
# Leave empty if you don't have one; qa-context will always fall through to live lookup.
QA_MEMORY_PATH=
# Where the exported evidence PDFs live
EVIDENCE_DIR=

# --- Environment tag convention (automation) ---
# Tags the production CI run must exclude, and the tag for read-only production cases.
TAG_PROD_READONLY=@prod-api
TAG_STAGING_ONLY=@staging-only
TAG_INTERNAL_NETWORK=@internal-network
TAG_PERFORMANCE=@performance

# --- Target status ---
# Name of the status a closed ticket moves to. The transition ID is discovered at
# runtime — never hard-code it.
REVIEW_STATUS_NAME=Product Review
